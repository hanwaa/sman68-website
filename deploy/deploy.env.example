# ============================================================
# Konfigurasi deploy — SALIN ke deploy/deploy.env lalu isi.
# deploy/deploy.env sudah di .gitignore, jadi nilai asli tidak
# ikut ter-push. Jangan pernah commit file itu.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#   $EDITOR deploy/deploy.env
# ============================================================

# --- Koneksi SSH ke VPS ---
# IP/port/user server tidak disimpan di repo. Ambil dari panel VPS.
VPS_HOST=
VPS_PORT=22
VPS_USER=

# --- Lokasi di server ---
# User OS yang menjalankan app (bukan user SSH di atas).
APP_USER=
APP_DIR=
# Lokasi file yang menyimpan hash package-lock.json terakhir.
LOCK_FILE=

# --- Build ---
# Jumlah CPU untuk `next build`. 1 bila VPS punya core terbatas.
BUILD_CPUS=2
