# ============================================================
# SMAN 68 Jakarta — Environment Variables
# Copy ke .env.local lalu isi nilainya (jangan commit .env.local)
# ============================================================

# PostgreSQL — Neon (cloud) atau server lokal. Driver dipilih otomatis dari hostname.
# Neon:  postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/sman68?sslmode=require
# Lokal: postgresql://sman68:pass@127.0.0.1:5432/sman68
DATABASE_URL=your-postgres-connection-string
# Maksimum koneksi pool untuk driver lokal `pg` (opsional, default 10)
# DB_POOL_MAX=10

# Cloudflare R2 (dashboard Cloudflare → R2 → Manage API Tokens)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=sma68-website
# URL publik bucket (r2.dev atau custom domain), tanpa trailing slash
R2_PUBLIC_BASE_URL=https://pub-8156d70781324453bda28e90108800f1.r2.dev

# Secret untuk endpoint migrasi/seed data statis ke Neon
# Panggil: POST /api/admin/seed dengan header x-seed-secret
SEED_SECRET=ubah-secret-ini

# TinyFish (opsional) — dipakai chatbot "Tanya Sekolah" untuk mencari info terbaru di web
# saat jawaban tidak ada di konten sekolah. Kosongkan untuk menonaktifkan.
# Kunci gratis dari https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Google Search Console (opsional) — hanya dipakai oleh skrip manual di scripts/,
# bukan oleh aplikasi. Kredensial dibaca dari environment atau dari file
# ~/.config/sman68-gsc.env (di luar repo, chmod 600).
# Alur: node scripts/gsc-auth.mjs  →  node scripts/gsc-sitemap.mjs
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
# GSC_SITE=https://sman68-jkt.my.id/
# GSC_AUTH_PORT=8976

# Sorotan Instagram di halaman Berita (opsional). Pilih salah satu cara:
#
# 1. Widget pihak ketiga (paling simpel, tanpa API): buat widget gratis untuk username
#    sekolah di SnapWidget/LightWidget, lalu isi URL iframe embed-nya di sini.
# NEXT_PUBLIC_INSTAGRAM_EMBED_URL=https://snapwidget.com/embed/xxxxxx
NEXT_PUBLIC_INSTAGRAM_USERNAME=smanegeri68jakarta
# Tinggi iframe widget dalam px (opsional, default 560)
# NEXT_PUBLIC_INSTAGRAM_EMBED_HEIGHT=560
#
# 2. JSON feed resmi dari layanan widget (mis. Behold: https://app.behold.so)
INSTAGRAM_FEED_URL=
#
# 3. Fetch langsung dari browser — URL wajib mengizinkan CORS.
# NEXT_PUBLIC_INSTAGRAM_FEED_URL=https://feeds.behold.so/xxxxxxxxxxxx
#
# 4. ScrapeCreators (butuh API key + credit) — dipakai hanya bila opsi 1-3 kosong.
SCRAPECREATORS_API_KEY=
INSTAGRAM_USERNAME=smanegeri68jakarta

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Var khusus proses build/deploy (opsional, biasanya tidak diisi
# di .env.local — dipakai lewat environment saat deploy).
# ============================================================
# Folder output build. Deploy VPS menulis ke .next-new lalu menukarnya
# dengan .next supaya downtime ~1-2 detik. Lihat deploy/remote-deploy.sh.
# NEXT_DIST_DIR=.next
# Jumlah CPU untuk next build (default Next: semua core)
# NEXT_BUILD_CPUS=2
# Gambar latar untuk generator OG image (scripts/generate-og.mjs)
# OG_HERO=public/assets/sekolah/sekolah-01-gedung.jpg
